# ═════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL via Supabase or any Postgres provider)
# ═════════════════════════════════════════════════════════════════════════════
# Get from: https://app.supabase.com → project → Settings → Database
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ═════════════════════════════════════════════════════════════════════════════
# NEXTAUTH (Authentication)
# ═════════════════════════════════════════════════════════════════════════════
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
# Set to your production URL in production (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"

# ═════════════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH (Optional — for "Sign in with Google")
# ═════════════════════════════════════════════════════════════════════════════
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ═════════════════════════════════════════════════════════════════════════════
# GROQ API (AI Tutor chat + feedback)
# ═════════════════════════════════════════════════════════════════════════════
# Get from: https://console.groq.com
GROQ_API_KEY="gsk_..."

# ═════════════════════════════════════════════════════════════════════════════
# SUPABASE (Optional — only needed if using Supabase client directly)
# ═════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ═════════════════════════════════════════════════════════════════════════════
# REDIS (Optional — for rate limiting / session caching)
# ═════════════════════════════════════════════════════════════════════════════
REDIS_URL="redis://localhost:6379"
